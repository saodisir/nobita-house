# deps
node_modules/
.pnp/
.pnp.js

# build
dist/
dist-ssr/
*.local

# vite / tooling caches
.vite/
node_modules/.vite/
.tsbuildinfo
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# credentials / private keys — never commit these
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*

# raw Rodin exports — large, unoptimized, not shipped.
# Optimized output lives in public/models/ and IS committed.
assets/raw/**
!assets/raw/.gitkeep

# Reference art and research stills are local working material, not distributed.
# The generated ones come back with `bun run gen:refs`; the house stills are
# third-party reference images the floor plan was measured from. See
# docs/asset-pipeline.md and README.md > Assets and credits.
assets/ref/
assets/*.jpg
assets/*.png

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# test output
coverage/
playwright-report/
test-results/
.vercel

# plans
plans/
